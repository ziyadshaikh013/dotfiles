{
	"$schema": "https://opencode.ai/config.json",
	"instructions": [
		"AGENTS.md",
		"docs",
		"~/.config/opencode/GLOBAL_INTRUCTIONS.md",
		".cursor/rules/*.md",
		"CLAUDE.md"
	],
	"mcp": {
		"context7": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@upstash/context7-mcp",
				"--api-key",
				"REPLACE_WITH_CONTEXT7_API_KEY"
			],
			"enabled": true
		},
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "chrome-devtools-mcp@latest"],
			"enabled": true
		},
		"coda": {
			"type": "remote",
			"url": "https://coda.io/apis/mcp",
			"enabled": true,
			"headers": {
				"Authorization": "Bearer REPLACE_WITH_CODA_API_TOKEN"
			}
		}
	}
}
