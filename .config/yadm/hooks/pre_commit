#!/bin/sh
# Block commits containing secrets. yadm aborts the command if this exits non-zero.
#
# yadm's worktree is $HOME but its git dir lives elsewhere, so gitleaks needs
# both pointed at explicitly — it cannot discover the repo from $HOME alone.

GITLEAKS="$(command -v gitleaks || echo "$HOME/.local/bin/gitleaks")"

if [ ! -x "$GITLEAKS" ]; then
  echo "pre_commit: gitleaks not found — refusing to commit unscanned."
  echo "Install it, or disable this hook: chmod -x \"$0\""
  exit 1
fi

GIT_DIR="$YADM_HOOK_REPO" \
GIT_WORK_TREE="$YADM_HOOK_WORK" \
"$GITLEAKS" git --staged --redact --no-banner \
  -c "$YADM_HOOK_WORK/.gitleaks.toml" \
  --log-level error "$YADM_HOOK_WORK" || {
  echo
  echo "══ COMMIT BLOCKED: staged changes look like they contain a secret. ══"
  echo "If it is a false positive, append a  # gitleaks:allow  comment."
  echo "Note: --no-verify does NOT skip yadm hooks. To bypass deliberately,"
  echo "temporarily disable this hook:  chmod -x \"$0\""
  exit 1
}
