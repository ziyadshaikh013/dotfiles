[user]
	name = ziyadshaikh013
	email = ziyadshaikh013@gmail.com

[core]
eol = lf
editor = nvim
whitespace = tabwidth=4
pager = delta

[delta]
navigate = true  # use n and N to move between diff sections
dark = true      # or light = true, or omit for auto-detection

[interactive]
diffFilter = delta --color-only

[alias]
ded = !git branch --merged master^

[blame]
coloring = repeatedLines
markUnblamables = true
markIgnoredlines = true

[branch]
sort = -committerdate

[checkout]
defaultRemote = origin

[color]
branch = auto
diff = auto
status = auto

[column]
ui = auto

[fetch]
output = compact
parallel = 0

[grep]
extendedRegexp = true

[merge]
tool = vimdiff
conflictStyle = zdiff3

[mergetool]
prompt = false
keepBackup = false

[mergetool "vimdiff"]
cmd = nvim -d "$LOCAL" "$BASE" "$REMOTE" "$MERGED" -c '$wincmd w' -c 'wincmd J'

[push]
default = current
followTags = true

[pull]
rebase = true

[rebase]
stat = true

[rerere]
enabled = true
autoUpdate = true

[showBranch]
default = HEAD
default = main

[status]
relativePaths = false
short = true
branch = true

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
