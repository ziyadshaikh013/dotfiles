# yadm's worktree is $HOME, so this file is the repo's root .gitignore.
# (Note: ~/.config/yadm/gitignore is NOT read by yadm 3.x — rules must live here.)

# Auto-generated / machine-specific
.config/nvim/lazy-lock.json
.config/opencode/package-lock.json

# Local AI tool config — contains API keys.
# Template tracked as opencode.json.example instead.
.config/opencode/opencode.json

# ~/.gemini is never tracked. It holds API keys, machine state, a full Chromium
# profile (cookies + saved logins) and agent session transcripts. No exceptions.
.gemini/

# Machine-local shell overrides (sourced by .zshrc if present)
.zshrc.local

# ~/.claude: only hand-written config is tracked. Everything else is
# credentials (.credentials.json), session transcripts, caches, and content
# Claude's own cloud sync manages (skills/synced, plugins/).
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/hooks/
!.claude/output-styles/
!.claude/skills/
.claude/skills/synced/
.claude.json
.claude.json.*

# Shared skills dir that ~/.claude/skills symlinks into. The lock file records
# which skills are installed; ~/.agents holds nothing else worth tracking.
.agents/*
!.agents/skills/
!.agents/.skill-lock.json
.claude/skills/agent-slack
